+    pub(super) fn explain_straighten(&mut self, order: &[NetId]) {
+        let mut tally = [0u64; 16];
+        let mut corridors: HashMap<(u8, u32), Vec<NetId>> = HashMap::new();
+        for (layer, pour, lists, _) in self.spoke_corridors() {
+            for cell in lists.iter().flatten() {
+                let nets = corridors.entry((layer as u8, *cell as u32)).or_default();
+                if !nets.contains(&pour) { nets.push(pour); }
+            }
+        }
+        for &net in order {
+            let state = &self.nets[net as usize];
+            if !state.routable { continue; }
+            let stairs: usize = state.branches.iter().map(|b| self.branch_bends(b).1).sum();
+            let category = if !state.complete { 9 } else if !state.plane.is_empty() { 10 } else if state.branches.len() <= state.fixed { 11 } else { 12 };
+            tally[category] += stairs as u64;
+            if category != 12 { continue; }
+            // Fixed branches' stairs.
+            tally[13] += state.branches[..state.fixed].iter().map(|b| self.branch_bends(b).1).sum::<usize>() as u64;
+            let fixed: HashSet<Node> = state.branches.iter().filter(|b| !b.nodes.is_empty())
+                .flat_map(|b| [b.nodes[0], *b.nodes.last().unwrap()])
+                .chain(state.branches[..state.fixed].iter().flat_map(|b| b.nodes.iter().copied())).collect();
+            let taken: HashSet<Node> = state.branches.iter().flat_map(|b| b.nodes.iter().copied()).collect();
+            let branches = state.branches.clone();
+            let first = state.fixed;
+            self.unstamp(net);
+            for branch in branches.iter().skip(first) {
+                let mut start = 0;
+                for index in 1..=branch.nodes.len() {
+                    if index < branch.nodes.len() && branch.nodes[index].layer == branch.nodes[start].layer { continue; }
+                    let run = &branch.nodes[start..index];
+                    if run.len() > 2 { self.explain_run(net, run, &taken, &fixed, &corridors, &mut tally); }
+                    start = index;
+                }
+            }
+            self.stamp(net);
+        }
+        eprintln!("straighten why: stairs by net: incomplete {}, plane {}, all fixed {}, straightened nets {} (in fixed branches {}); per stair the furthest stage: no window {}, span only {}, no better shape {}, step blocked {}, touches the net {}, guard/corridor/pin row {}, pour cut {}, would go {}; past the span limits would go {}",
+            tally[9], tally[10], tally[11], tally[12], tally[13], tally[0], tally[1], tally[2], tally[3], tally[4], tally[5], tally[6], tally[7], tally[8]);
+    }
