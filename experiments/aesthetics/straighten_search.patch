+impl Router {
+    /// Per stair-step of the run: the furthest stage any window over it got
+    /// (0 no window: fixed node or the run's end inside, 1 span, 2 no
+    /// shape better, 3 a step blocked, 4 touches the net, 5 guard or
+    /// corridor or pin row, 6 pour cut, 7 would go).
+    fn explain_run(&self, net: NetId, nodes: &[Node], taken: &HashSet<Node>, fixed: &HashSet<Node>,
+                   corridors: &HashMap<(u8, u32), Vec<NetId>>, tally: &mut [u64; 16]) {
+        let nx = self.grid.nx as i64;
+        let pitch = self.grid.pitch;
+        let layer = nodes[0].layer;
+        let xy = |node: &Node| (node.cell as i64 % nx, node.cell as i64 / nx);
+        let mut directions = Vec::new();
+        for pair in nodes.windows(2) {
+            let (a, b) = (xy(&pair[0]), xy(&pair[1]));
+            match direction_of(b.0 - a.0, b.1 - a.1) { Some(d) => directions.push(d), None => return }
+        }
+        let stairs = stair_spans(&directions, pitch);
+        if stairs.is_empty() { return; }
+        let mut corners = vec![0];
+        corners.extend((1..directions.len()).filter(|k| directions[k - 1] != directions[*k]));
+        corners.push(nodes.len() - 1);
+        let mut along = vec![0.0];
+        for d in &directions { along.push(along.last().unwrap() + if d % 2 == 1 { pitch * std::f64::consts::SQRT_2 } else { pitch }); }
+        let last = corners.len() - 1;
+        for (s, e) in stairs {
+            let mut best = 0usize;
+            // Whether a window without the span limits would get past them.
+            let mut unlimited = 0usize;
+            for a in 0..corners.len() {
+                for b in a + 2..corners.len() {
+                    let (i, j) = (corners[a], corners[b]);
+                    if !(i < s && j > e) { continue; }
+                    if nodes[i + 1..j].iter().any(|node| fixed.contains(node)) { continue; }
+                    let limited = along[j] - along[i] > SPAN_MM || b > a + SPAN_CORNERS;
+                    let mut stage = 1;
+                    let (low, high) = (corners[a.saturating_sub(3)], corners[(b + 3).min(last)]);
+                    let score = bend_score(&directions[low..high], pitch);
+                    let (from, to) = (xy(&nodes[i]), xy(&nodes[j]));
+                    for shape in shortest_shapes(to.0 - from.0, to.1 - from.1) {
+                        if shape[..] == directions[i..j] { continue; }
+                        let candidate: Vec<u8> = directions[low..i].iter().chain(&shape).chain(&directions[j..high]).copied().collect();
+                        if bend_score(&candidate, pitch) >= score { stage = stage.max(2); continue; }
+                        let mut cell = nodes[i].cell as usize;
+                        let mut path = Vec::new();
+                        let free = shape.iter().all(|direction| match self.step_free(net, layer as usize, cell, *direction) {
+                            Some(next) => { cell = next; path.push(Node { layer, cell: next as u32 }); true }
+                            None => false,
+                        });
+                        if !free || *path.last().unwrap() != nodes[j] { stage = stage.max(3); continue; }
+                        let interior = &path[..path.len() - 1];
+                        let window = &nodes[i + 1..j];
+                        if interior.iter().any(|node| fixed.contains(node) || (taken.contains(node) && !window.contains(node)) || nodes[..=i].contains(node) || nodes[j..].contains(node)) {
+                            stage = stage.max(4); continue;
+                        }
+                        let mut cut = 0isize;
+                        let mut enters = false;
+                        for node in interior {
+                            let (guarded, on_pour) = self.guarded_and_cut(net, *node, corridors);
+                            enters |= guarded && !window.contains(node);
+                            cut += on_pour as isize;
+                        }
+                        for node in window { cut -= self.guarded_and_cut(net, *node, corridors).1 as isize; }
+                        if enters { stage = stage.max(5); continue; }
+                        if cut > 0 { stage = stage.max(6); continue; }
+                        stage = 7;
+                    }
+                    if limited { unlimited = unlimited.max(stage); } else { best = best.max(stage); }
+                }
+            }
+            tally[best] += 1;
+            if unlimited > best && unlimited >= 7 { tally[8] += 1; }
+        }
+    }
