+// ---- temporary diagnostic (not for commit): why stair-steps stay ----
+/// Stair-steps of a run's directions as (first turn node, last turn node).
+fn stair_spans(directions: &[u8], pitch: f64) -> Vec<(usize, usize)> {
+    let step = |d: u8| if d % 2 == 1 { pitch * std::f64::consts::SQRT_2 } else { pitch };
+    let mut bends: Vec<(i32, f64, f64, usize, usize)> = Vec::new();
+    let mut along = 0.0;
+    for index in 1..directions.len() {
+        along += step(directions[index - 1]);
+        let turn = (directions[index] as i32 - directions[index - 1] as i32).rem_euclid(8);
+        let turn = if turn > 4 { turn - 8 } else { turn };
+        if turn == 0 {
+            continue;
+        }
+        match bends.last_mut() {
+            Some(last) if last.0.signum() == turn.signum() && along - last.2 < MERGE_MM && (last.0 + turn).abs() <= 2 => {
+                last.0 += turn;
+                last.2 = along;
+                last.4 = index;
+            }
+            _ => bends.push((turn, along, along, index, index)),
+        }
+    }
+    let mut out = Vec::new();
+    let mut index = 1;
+    while index < bends.len() {
+        let (first, second) = (bends[index - 1], bends[index]);
+        if first.0 + second.0 == 0 && second.1 - first.2 < STAIR_MM {
+            out.push((first.3, second.4));
+            index += 2;
+        } else {
+            index += 1;
+        }
+    }
+    out
