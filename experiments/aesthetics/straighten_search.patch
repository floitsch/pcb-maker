+        }
+        let (x0, y0) = ((x0 - margin).max(0), (y0 - margin).max(0));
+        let x1 = (x1 + margin).min(self.grid.nx as i64 - 1);
+        let y1 = (y1 + margin).min(self.grid.ny as i64 - 1);
+        let width = x1 - x0 + 1;
+        let cells = (width * (y1 - y0 + 1)) as usize;
+        if cells > SEARCH_CELLS {
+            return None;
+        }
+        let local = |cell: u32| {
+            let (x, y) = xy(cell);
